use Del001\AdminUiColorSwap\Block\Adminhtml\Theme;
use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Theme $block */
/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */

$stylesheet = $block->getStylesheet();
?>
<?php if ($stylesheet !== null): ?>
    <link rel="stylesheet"
          href="<?= $escaper->escapeUrl($block->getViewFileUrl('Del001_AdminUiColorSwap::css/' . $stylesheet . '.css')) ?>">
<?php endif; ?>
<?php if ($stylesheet === 'custom_admin' && ($variables = $block->getCustomCssVariables()) !== ''): ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('style', [], ':root{' . $variables . '}', false) ?>
<?php endif; ?>
